@page "/audit"
@inject IAuditService AuditService

<PageTitle>Audit Log - DMS</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Audit Log</MudText>
<MudText Class="mb-8">View system activity and audit trails</MudText>

<MudPaper Elevation="2">
    <MudTable Items="@_auditLogs" Hover="true" Dense="true" Loading="@_isLoading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">System Activity</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAuditLogs" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Timestamp</MudTh>
            <MudTh>User</MudTh>
            <MudTh>Action</MudTh>
            <MudTh>Entity</MudTh>
            <MudTh>Details</MudTh>
            <MudTh>IP Address</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Timestamp">@context.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")</MudTd>
            <MudTd DataLabel="User">
                @if (context.User != null)
                {
                    @($"{context.User.FirstName} {context.User.LastName}")
                }
            </MudTd>
            <MudTd DataLabel="Action">
                <MudChip Size="Size.Small" Color="@GetActionColor(context.Action)">@context.Action</MudChip>
            </MudTd>
            <MudTd DataLabel="Entity">@context.EntityType</MudTd>
            <MudTd DataLabel="Details">@context.Details</MudTd>
            <MudTd DataLabel="IP Address">@context.IpAddress</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<AuditLog> _auditLogs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditLogs();
    }

    private async Task LoadAuditLogs()
    {
        _isLoading = true;
        try
        {
            _auditLogs = (await AuditService.GetAuditLogsAsync(0, 100)).ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Color GetActionColor(string action)
    {
        return action.ToLower() switch
        {
            var a when a.Contains("create") => Color.Success,
            var a when a.Contains("update") => Color.Info,
            var a when a.Contains("delete") => Color.Error,
            var a when a.Contains("approved") => Color.Success,
            var a when a.Contains("rejected") => Color.Warning,
            _ => Color.Default
        };
    }
}
