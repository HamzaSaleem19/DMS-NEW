@page "/workflows"
@inject IWorkflowService WorkflowService
@inject ISnackbar Snackbar

<PageTitle>Workflows - DMS</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Workflow Management</MudText>
<MudText Class="mb-8">Manage document approval workflows</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Pending Tasks" Icon="@Icons.Material.Filled.PendingActions">
        <MudTable Items="@_pendingTasks" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Document</MudTh>
                <MudTh>Step</MudTh>
                <MudTh>Assigned Date</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Document">@context.WorkflowInstance?.Document?.Title</MudTd>
                <MudTd DataLabel="Step">@context.WorkflowStep?.Name</MudTd>
                <MudTd DataLabel="Assigned Date">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip Size="Size.Small" Color="@GetStepStatusColor(context.Status)">@context.Status</MudChip>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Size="Size.Small"
                              Variant="Variant.Filled"
                              Color="Color.Success"
                              StartIcon="@Icons.Material.Filled.Check"
                              OnClick="@(() => ApproveTask(context.Id))">
                        Approve
                    </MudButton>
                    <MudButton Size="Size.Small"
                              Variant="Variant.Filled"
                              Color="Color.Error"
                              StartIcon="@Icons.Material.Filled.Close"
                              OnClick="@(() => RejectTask(context.Id))"
                              Class="ml-2">
                        Reject
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Workflow Templates" Icon="@Icons.Material.Filled.AccountTree">
        <MudGrid>
            @foreach (var template in _templates)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@template.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@template.Description</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" GutterBottom="true">Steps:</MudText>
                            <MudList Dense="true">
                                @foreach (var step in template.Steps.OrderBy(s => s.StepOrder))
                                {
                                    <MudListItem Icon="@Icons.Material.Filled.ArrowRight">
                                        Step @step.StepOrder: @step.Name
                                    </MudListItem>
                                }
                            </MudList>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility">
                                View Details
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudTabPanel>
</MudTabs>

@code {
    private List<WorkflowStepInstance> _pendingTasks = new();
    private List<WorkflowTemplate> _templates = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingTasks();
        await LoadTemplates();
    }

    private async Task LoadPendingTasks()
    {
        // For demo purposes - in real app, get current user ID
        _pendingTasks = (await WorkflowService.GetPendingTasksAsync("current-user-id")).ToList();
    }

    private async Task LoadTemplates()
    {
        _templates = (await WorkflowService.GetActiveWorkflowTemplatesAsync()).ToList();
    }

    private async Task ApproveTask(int taskId)
    {
        try
        {
            await WorkflowService.ApproveStepAsync(taskId, "current-user-id", "Approved");
            Snackbar.Add("Task approved successfully!", Severity.Success);
            await LoadPendingTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectTask(int taskId)
    {
        try
        {
            await WorkflowService.RejectStepAsync(taskId, "current-user-id", "Rejected");
            Snackbar.Add("Task rejected!", Severity.Warning);
            await LoadPendingTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStepStatusColor(StepStatus status)
    {
        return status switch
        {
            StepStatus.Pending => Color.Default,
            StepStatus.InProgress => Color.Info,
            StepStatus.Approved => Color.Success,
            StepStatus.Rejected => Color.Error,
            StepStatus.Skipped => Color.Secondary,
            _ => Color.Default
        };
    }
}
